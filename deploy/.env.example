# Kopieren nach `.env` und anpassen. `.env` NIE committen.
# Nur Platzhalter - keine echten Zugangsdaten hier eintragen.

# Datenbank (Passwort alphanumerisch waehlen, z. B. mit `openssl rand -hex 24`)
FHP_DB_USER=fhp
FHP_DB_NAME=fhp
FHP_DB_PASSWORD=CHANGE_ME

# Host-Pfad fuer die Postgres-Daten.
# Lokal relativ zu deploy/; auf TrueNAS absoluter Pfad, z. B. /mnt/tank/apps/foodhealth/postgres
FHP_DB_PATH=./data/postgres

# Auf dem Host veroeffentlichter Port der API
FHP_API_PORT=8000

# App-Einstellungen
FHP_ENV=prod
FHP_TIMEZONE=Europe/Berlin
